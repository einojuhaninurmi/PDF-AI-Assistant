import streamlit as st
from pypdf import PdfReader
from dotenv import load_dotenv
from openai import OpenAI
import os
import chromadb
from chromadb.utils import embedding_functions
from langchain_text_splitters import RecursiveCharacterTextSplitter



load_dotenv()

OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")

client = OpenAI(api_key=OPENAI_API_KEY)

st.set_page_config(page_title="PDF AI Assistant (RAG)", layout="wide")
st.title("PDF AI Assistant with RAG")



embedding_function = embedding_functions.OpenAIEmbeddingFunction(
    api_key=OPENAI_API_KEY,
    model_name="text-embedding-3-small"
)

chroma_client = chromadb.Client(
    chromadb.config.Settings(
        persist_directory="./chroma_db",
        is_persistent=True
    )
)

collection = chroma_client.get_or_create_collection(
    name="documents",
    embedding_function=embedding_function
)



pdfs = st.file_uploader(
    "Upload PDFs",
    type="pdf",
    accept_multiple_files=True
)

if pdfs:

    splitter = RecursiveCharacterTextSplitter(
        chunk_size=1000,
        chunk_overlap=200
    )

    documents = []
    metadatas = []
    ids = []

    for pdf in pdfs:

        reader = PdfReader(pdf)

        for page_number, page in enumerate(reader.pages):
            page_text = page.extract_text()

            if page_text:

                chunks = splitter.split_text(page_text)

                for i, chunk in enumerate(chunks):
                    documents.append(chunk)
                    metadatas.append({
                        "file": pdf.name,
                        "page": page_number + 1
                    })
                    ids.append(f"{pdf.name}_{page_number}_{i}")

    if documents:
        collection.add(
            documents=documents,
            metadatas=metadatas,
            ids=ids
        )


        st.success("PDFs processed and stored in ChromaDB!")


question = st.text_input("Ask a question about the documents")

if question:

    with st.spinner("Searching relevant context..."):

        results = collection.query(
            query_texts=[question],
            n_results=5
        )

        if not results["documents"]:
            st.warning("No relevant information found.")
        else:
            context = "\n\n".join(results["documents"][0])

            response = client.chat.completions.create(
                model="gpt-4o-mini",
                messages=[
                    {
                        "role": "user",
                        "content": f"""
                        Answer the question using ONLY the context below.
                        If the answer is not in the context, say that you don't know.

                        CONTEXT:
                        {context}

                        QUESTION:
                        {question}
                        """
                    }
                ]
            )

            answer = response.choices[0].message.content

            st.subheader("Answer")
            st.write(answer)

            st.subheader("Sources")
            for meta in results["metadatas"][0]:
                st.write(f"• {meta['file']} — Page {meta['page']}")
